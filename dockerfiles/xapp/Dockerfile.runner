# syntax=docker/dockerfile:1.7

FROM python:3.11-slim-bookworm AS rmr-builder

ARG RMR_VERSION=4.9.4
ARG RMR_COMMIT=f447e29dffd0a24fcf02288b9591ce7d03a8fb9d
ARG E2AP_VERSION=1.1.0
ARG E2AP_COMMIT=746aa4bfe7cbd3ac8f3193c25b301efc3a151c5a

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/o-ran-sc/ric-plt-lib-rmr.git /src/rmr \
    && cd /src/rmr \
    && git checkout --detach "${RMR_COMMIT}" \
    && test "$(git describe --tags --exact-match HEAD)" = "${RMR_VERSION}"

COPY dockerfiles/xapp/ric-plt-lib-rmr-arm64.patch /src/rmr/ric-plt-lib-rmr-arm64.patch
RUN cd /src/rmr && git apply ./ric-plt-lib-rmr-arm64.patch

RUN cmake -S /src/rmr -B /src/rmr/.build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DDEV_PKG=0 \
      -DBUILD_DOC=0 \
      -DIGNORE_LIBDIR=1 \
    && cmake --build /src/rmr/.build --parallel \
    && cmake --install /src/rmr/.build

RUN git clone --filter=blob:none https://github.com/o-ran-sc/ric-plt-libe2ap.git /src/libe2ap \
    && cd /src/libe2ap \
    && git checkout --detach "${E2AP_COMMIT}" \
    && test "$(git describe --tags --exact-match HEAD)" = "${E2AP_VERSION}"

RUN cmake -S /src/libe2ap -B /src/libe2ap/.build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DDEV_PKG=0 \
      -DBUILD_DOC=0 \
    && cmake --build /src/libe2ap/.build --parallel \
    && cmake --install /src/libe2ap/.build

FROM python:3.11-slim-bookworm

ARG SC_RIC_COMMIT=7fb94911c4197e6c0c93d20bc2e6e73d9444d14f

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rmr-builder /usr/local/lib/librmr_si.so* /usr/local/lib/
COPY --from=rmr-builder /usr/local/lib/libriclibe2ap.so* /usr/local/lib/
COPY --from=rmr-builder /usr/local/bin/rmr_probe /opt/e2/rmr_probe
RUN ldconfig && chmod 0755 /opt/e2/rmr_probe

ENV LD_LIBRARY_PATH=/usr/local/lib \
    PYTHONUNBUFFERED=1

WORKDIR /opt
RUN git clone --filter=blob:none https://github.com/o-ran-sc/ric-plt-xapp-frame-py.git \
      /opt/ric-plt-xapp-frame-py \
    && cd /opt/ric-plt-xapp-frame-py \
    && git checkout --detach "${SC_RIC_COMMIT}"

COPY dockerfiles/xapp/ric-plt-xapp-frame-py.patch \
  /opt/ric-plt-xapp-frame-py/ric-plt-xapp-frame-py.patch
RUN cd /opt/ric-plt-xapp-frame-py \
    && git apply ./ric-plt-xapp-frame-py.patch \
    && python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
      asn1tools \
      inotify==0.2.12 \
      inotify_simple==2.0.1 \
      mdclogpy==1.1.4 \
      msgpack==1.2.2 \
      protobuf==3.20.3 \
      python-dateutil==2.9.0.post0 \
      requests==2.34.2 \
      six==1.17.0 \
    && python -m pip install --no-cache-dir --no-deps /opt/ric-plt-xapp-frame-py \
    && python -c 'from ricxappframe.rmr import rmr; import ricxappframe.xapp_rest; import ricxappframe.xapp_subscribe; from ricxappframe.e2ap.asn1 import IndicationMsg; assert rmr.RMR_MAX_RCV_BYTES > 0'

RUN mkdir -p /opt/xApps /opt/ric/config \
    && chmod 0755 /opt/xApps /opt/ric/config

WORKDIR /opt/xApps
CMD ["/bin/bash"]

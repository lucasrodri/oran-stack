FROM ubuntu:22.04

ARG OPEN5GS_VERSION=v2.7.7

# Kubernetes runs MongoDB as a separate StatefulSet. Keep the NF image focused
# on Open5GS and use the external database by default.
ENV SKIP_MONGODB=true

# NOTE: This container must be run with the following flags:
#   --device=/dev/net/tun \
#   --cap-add=NET_ADMIN \
# These are required for TUN interface creation (e.g. ip tuntap add name ogstun mode tun)

RUN apt-get update && apt-get install -y \
    curl iproute2 iptables gettext-base

RUN apt-get install -y \
    python3-pip python3-setuptools python3-wheel ninja-build \
    build-essential flex bison git cmake \
    libsctp-dev libgnutls28-dev libgcrypt-dev libssl-dev \
    libmongoc-dev libbson-dev libyaml-dev libnghttp2-dev \
    libmicrohttpd-dev libcurl4-gnutls-dev libtins-dev \
    libtalloc-dev meson

RUN if apt-cache show libidn-dev > /dev/null 2>&1; then \
        apt-get install -y --no-install-recommends libidn-dev; \
    else \
        apt-get install -y --no-install-recommends libidn11-dev; \
    fi

RUN git clone --depth 1 --branch ${OPEN5GS_VERSION} https://github.com/open5gs/open5gs

WORKDIR /open5gs

RUN meson build --prefix=$(pwd)/install

RUN ninja -C build

RUN ninja -C build install

# Copy configuration templates (will be substituted at runtime by entrypoint.sh)
COPY configs/ /open5gs/configs/
RUN mkdir -p /open5gs/install/etc/open5gs/

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
